{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "outDir": "./lib",
    "rootDir": "..",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@kkk/template-contracts": [
        "../template-contracts/src/index.ts"
      ],
      "template/server": [
        "../template/src/server.ts"
      ],
      "@kkk/richtext": [
        "../richtext"
      ]
    },
    "jsx": "react",
    "declaration": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "preserveWatchOutput": true,
    "pretty": true,
    "inlineSourceMap": false,
    "alwaysStrict": true,
    "types": [
      "node"
    ],
    "noEmit": false,
    "strictPropertyInitialization": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts",
    "vite.plugin/**/*.ts",
    "eslint.config.ts",
    "vite.config.ts",
    "../template/src/**/*.ts",
    "../template/src/**/*.tsx",
    "../template-contracts/src/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
