  "scripts": {
    "build": "pnpm --dir ../amagi/packages/core run build && pnpm --dir .. --filter template run build && cross-env NODE_ENV=production vite build && tsdown",
    "build:check": "tsc --noEmit && pnpm build",
    "check:node": "node -e \"if (Number(process.versions.node.split('.')[0]) < 22) throw new Error('Node.js >= 22 is required')\"",
    "dev": "cross-env EBV_FILE=\"development.env\" node --import tsx src/app.ts --trace-deprecation",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "smoke:pack": "node ./scripts/pack-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pub": "npm publish --access public",
    "sort": "sort-package-json",
    "sync": "curl -X PUT \"https://registry-direct.npmmirror.com/-/package/karin-plugin-kkk/syncs\"",
    "watch": "cross-env EBV_FILE=\"development.env\" tsx watch --include \"src/**/*.ts\" --include \"../template/src/dev/mock-server.ts\" --include \"../template/src/main.ts\" --include \"../template/src/server.ts\" --include \"../template-contracts/src/**/*.ts\" src/app.ts --trace-deprecation"
  },
  "dependencies": {
    "@karinjs/md-html": "^1.3.0",
