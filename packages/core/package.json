    "@karinjs/plugin-adapter-milky": "^1.2.5",
    "@karinjs/plugin-puppeteer": "^2.3.1",
    "@ikenxuan/amagi": "workspace:*",
    "@kkk/richtext": "workspace:*",
    "@kkk/template-contracts": "workspace:*",
    "@types/express": "5.0.6",
    "@types/heic-decode": "^2.0.0",
    "@types/pngjs": "^6.0.5",
    "cookie": "^1.1.1",
    "date-fns": "^4.3.0",
    "happy-dom": "^20.9.0",
    "heic-decode": "^2.1.0",
    "http-proxy-middleware": "4.0.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
