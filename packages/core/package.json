  "type": "module",
  "bin": {
    "kkk-auto-update": "./scripts/auto-update-from-tgz.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./richtext": {
      "types": "./lib/core_chunk/richtext.d.mts",
      "import": "./lib/core_chunk/richtext.js"
